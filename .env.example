# ===== 공통 =====
DOMAIN=smart-clean-ashtray.com

# ===== FastAPI =====
# 32자 이상 필수 (python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=change-me-to-a-random-string-at-least-32-chars
DATABASE_URL=mysql+asyncmy://sca:sca_password@mysql:3306/sca
MQTT_HOST=mosquitto
MQTT_PORT=1883
REDIS_URL=redis://redis:6379/0
# API 워커 수 (Redis 덕분에 여러 개 가능)
WEB_CONCURRENCY=2
# 쿠키 도메인 (www/admin/api 서브도메인 공유). 로컬 개발 시 비워두기
COOKIE_DOMAIN=.smart-clean-ashtray.com
COOKIE_SECURE=true
CORS_ORIGINS=https://www.smart-clean-ashtray.com,https://admin.smart-clean-ashtray.com
# 관리자 API 허용 IP/CIDR (Nginx allowlist와 동일하게 유지)
ADMIN_ALLOWED_IPS=1.2.3.4,192.168.0.0/24

# Gmail SMTP (앱 비밀번호 사용)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Firebase Admin SDK 서비스 계정 JSON 경로 (컨테이너 내부)
FIREBASE_CREDENTIALS=/run/secrets/firebase.json

FIRMWARE_DIR=/data/firmware
FIRMWARE_BASE_URL=https://api.smart-clean-ashtray.com/firmware

# ===== MySQL =====
MYSQL_DATABASE=sca
MYSQL_USER=sca
MYSQL_PASSWORD=sca_password
MYSQL_ROOT_PASSWORD=change-me-root
