{
  "version": 1,
  "author": "Smart Clean Ashtray",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-s3-devkitc-1", "id": "esp", "top": 0, "left": 0,
      "attrs": { "flashSize": "8", "serialInterface": "USB_SERIAL_JTAG" } },

    { "type": "wokwi-potentiometer", "id": "gas", "top": -140, "left": -230,
      "attrs": { "value": "250" } },
    { "type": "wokwi-pushbutton", "id": "flame", "top": -40, "left": -250,
      "attrs": { "color": "red", "label": "FLAME", "key": "f", "bounce": "0" } },
    { "type": "wokwi-hc-sr04", "id": "us", "top": 60, "left": -330,
      "attrs": { "distance": "30" } },
    { "type": "wokwi-pir-motion-sensor", "id": "pir", "top": 200, "left": -230 },

    { "type": "wokwi-led", "id": "pump_ext", "top": -150, "left": 140,
      "attrs": { "color": "blue", "label": "EXTINGUISH" } },
    { "type": "wokwi-led", "id": "pump_deo", "top": -150, "left": 200,
      "attrs": { "color": "green", "label": "DEODORIZE" } },
    { "type": "wokwi-led", "id": "pump_cln", "top": -150, "left": 260,
      "attrs": { "color": "white", "label": "CLEAN" } },
    { "type": "wokwi-servo", "id": "lid", "top": -40, "left": 200 },
    { "type": "wokwi-buzzer", "id": "buzzer", "top": 90, "left": 220, "attrs": { "volume": "0.1" } },
    { "type": "wokwi-neopixel", "id": "rgb", "top": 180, "left": 210 },
    { "type": "board-ssd1306", "id": "oled", "top": 250, "left": 130, "attrs": { "i2cAddress": "0x3c" } }
  ],
  "connections": [
    [ "gas:VCC", "esp:3V3.1", "red", [] ],
    [ "gas:GND", "esp:GND.1", "black", [] ],
    [ "gas:SIG", "esp:4", "orange", [] ],

    [ "flame:1.l", "esp:5", "red", [] ],
    [ "flame:2.l", "esp:GND.1", "black", [] ],

    [ "us:VCC", "esp:5V", "red", [] ],
    [ "us:GND", "esp:GND.1", "black", [] ],
    [ "us:TRIG", "esp:8", "purple", [] ],
    [ "us:ECHO", "esp:9", "violet", [] ],

    [ "pir:VCC", "esp:3V3.1", "red", [] ],
    [ "pir:GND", "esp:GND.1", "black", [] ],
    [ "pir:OUT", "esp:14", "yellow", [] ],

    [ "pump_ext:A", "esp:15", "blue", [] ],
    [ "pump_ext:C", "esp:GND.2", "black", [] ],
    [ "pump_deo:A", "esp:16", "green", [] ],
    [ "pump_deo:C", "esp:GND.2", "black", [] ],
    [ "pump_cln:A", "esp:18", "white", [] ],
    [ "pump_cln:C", "esp:GND.2", "black", [] ],

    [ "lid:PWM", "esp:17", "orange", [] ],
    [ "lid:V+", "esp:5V", "red", [] ],
    [ "lid:GND", "esp:GND.2", "black", [] ],

    [ "buzzer:2", "esp:10", "red", [] ],
    [ "buzzer:1", "esp:GND.3", "black", [] ],

    [ "rgb:DIN", "esp:38", "green", [] ],
    [ "rgb:VDD", "esp:5V", "red", [] ],
    [ "rgb:VSS", "esp:GND.3", "black", [] ],

    [ "oled:VCC", "esp:3V3.2", "red", [] ],
    [ "oled:GND", "esp:GND.4", "black", [] ],
    [ "oled:SDA", "esp:21", "cyan", [] ],
    [ "oled:SCL", "esp:47", "magenta", [] ]
  ],
  "dependencies": {}
}
