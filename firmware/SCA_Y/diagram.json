  "connections": [
    [ "gas:VCC", "esp:3V3.1", "red", [] ],
    [ "gas:GND", "esp:GND.1", "black", [] ],
    [ "gas:SIG", "esp:5", "orange", [] ],

    [ "dht:VCC", "esp:3V3.1", "red", [] ],
    [ "dht:GND", "esp:GND.1", "black", [] ],
    [ "dht:SDA", "esp:14", "green", [] ],

    [ "us:VCC", "esp:5V", "red", [] ],
    [ "us:GND", "esp:GND.1", "black", [] ],
    [ "us:TRIG", "esp:6", "purple", [] ],
    [ "us:ECHO", "esp:7", "violet", [] ],

    [ "float:2", "esp:8", "yellow", [] ],
    [ "float:1", "esp:GND.1", "black", [] ],

    [ "pump:A", "esp:18", "blue", [] ],
    [ "pump:C", "esp:GND.2", "black", [] ],

    [ "buzzer:2", "esp:17", "red", [] ],
    [ "buzzer:1", "esp:GND.2", "black", [] ],

    [ "rgb:DIN", "esp:4", "green", [] ],
    [ "rgb:VDD", "esp:5V", "red", [] ],
    [ "rgb:VSS", "esp:GND.3", "black", [] ],

    [ "oled:VCC", "esp:3V3.2", "red", [] ],
    [ "oled:GND", "esp:GND.4", "black", [] ],
    [ "oled:SDA", "esp:21", "cyan", [] ],
    [ "oled:SCL", "esp:47", "magenta", [] ]
